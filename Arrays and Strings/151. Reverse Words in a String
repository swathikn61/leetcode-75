class Solution {
public:
    string reverseWords(string s) {
        vector<string> words;
        string word = "";
        // Extract words
        for (int i = 0; i < s.size(); i++) {
            if (s[i] != ' ') {
                word += s[i];
            }
            else if (!word.empty()) {
                words.push_back(word);
                word = "";
            }
        }

        // Add the last word
        if (!word.empty()) {
            words.push_back(word);
        }

        // Build answer in reverse order
        string ans = "";

        for (int i = words.size() - 1; i >= 0; i--) {
            if (!ans.empty()) {
                ans += ' ';
            }
            ans += words[i];
        }
        return ans;
    }
};