class Solution {
public:
    vector<int> countBits(int n) {
        vector<int> ans(n+1); //intially ans = [0, ?, ?, ?, ?, ?] -> 0 = 000

        for(int i = 1; i <= n; i++){
            ans[i] = ans[i >> 1] + (i & 1); // i>>1 removes the last bit -> 6 = 110 -> 6 >> 1 -> 110 → 11 -> 3
        }
        return ans;
    }
};