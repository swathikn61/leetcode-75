class Solution {
public:
// Same-direction / slow + fast pointers
    void moveZeroes(vector<int>& nums) {
        int left = 0; // left = position where the next non-zero element should go

// right = scans every element in the array
        for(int right = 0; right < nums.size(); right++){
            if(nums[right] != 0){
                swap(nums[left], nums[right]); // Put the non-zero element at the 'left' position 
                left++;
            }
        } 
    }
};